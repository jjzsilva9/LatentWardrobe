# Bulk generated outputs are NOT committed: ~26MB/member (a 180-member batch
# is ~4.7GB) and everything is regenerable bit-for-bit from the committed
# manifests (seeds + garments + prompts) + code + mesh library.
# Only the small experimental record is kept in git; back up full outputs/
# to OneDrive if a batch is worth preserving without regeneration.
#
# crowd_library_20260713 is a deliberate exception: it depends on the
# stage1eval/shapeonly Paint3D pipeline scripts (see
# .claude/setup/patches/paint3d_stage1eval_shapeonly.patch), which weren't
# reproducible from setup scripts until that patch existed, so it isn't
# safely bit-for-bit regenerable and is kept in full.
outputs/**
!outputs/factorial7_20260706/**
!outputs/crowd_library_20260713/**
# crowd_library_20260715 (meshfixed + stage1eval) kept in full too
# (2026-07-17, user-requested): the batch of record for the report.
!outputs/crowd_library_20260715_meshfixed/**
!outputs/crowd_library_20260715_stage1eval/**
# plots (incl. the README hero contact sheet) for the current batch -- small
# PNGs, needed for GitHub rendering; the batch's bulk data stays ignored.
!outputs/crowd_library_20260715_stage1eval/plots/**
# presentation material (2026-07-16): medieval_villagers' complete pipeline
# stills for every method -- depth conditioning, SD init view, inpaint
# views/masks, per-view texture projections, UV albedo, eval turntable
# frames (~7MB/member, 35 members). One theme keeps the push manageable;
# widen the pattern if another theme's renders are needed. Turntable mp4s
# and .obj bulk stay ignored.
!outputs/crowd_library_20260715_stage1eval/*/medieval_villagers/**/*.png
!outputs/**/
!outputs/**/manifest.json
!outputs/**/metrics.json
!outputs/**/run.log
!outputs/**/README.md

# MakeHuman source packs: only the staged .obj files in assets/meshes are
# needed (see assets/meshes/README.md); raw packs can be re-downloaded.
assets/makehuman_src/

# scripts/evaluate_crowd.py's DreamSim/DINOv2/DINO/CLIP weight cache
# (auto-downloaded on first run, ~3.4GB -- see MODEL_CACHE_DIR there).
models/

__pycache__/
*.pyc
